generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String // Hashed password
  name             String?
  role             String    @default("USER") // ADMIN, USER, AUDITOR, RECORDS_MANAGER
  clearanceLevel   Int       @default(1)      // 1=Public, 5=Top Secret
  createdAt        DateTime  @default(now())
  
  // Relations
  records          Record[]  // Records owned by user
  legalHoldsOwned  LegalHold[] @relation("LegalHoldOwner")
  auditLogs        AuditLog[]
  groups           Group[]
  uploadedVersions RecordVersion[] // Versions uploaded by user
  createdClassifications ClassificationNode[] // Classifications created by user

  // Department Relation
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])

  // New: Account Expiry
  accountExpiresAt DateTime?

  // 2FA Fields
  otp        String?
  otpExpires DateTime?

  // Shared Records
  sharedRecords Record[] @relation("UserSharedRecords")
  
  // Record Access
  accessPermissions RecordAccess[]
}

model Group {
  id        String   @id @default(uuid())
  name      String
  type      String // DEPARTMENT, TEAM, PROJECT
  users     User[]
  
  // Relations
  // Relations
  sharedRecords Record[] @relation("GroupSharedRecords")
  projectRecords Record[] @relation("ProjectRecords")
  
  // Record Access
  accessPermissions RecordAccess[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// NEW ORGANIZATION & CLASSIFICATION SCHEMA
// ---------------------------------------------------------

model Organization {
  id          String           @id @default(uuid())
  name        String
  status      String           @default("ACTIVE") // ACTIVE, SUSPENDED
  departments Department[]
  categories  RecordCategory[]
  classificationNodes ClassificationNode[] // New dynamic classification tree
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Department {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  parentId       String?
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
  records        Record[]
  
  // New Relations
  users          User[]
  classifications ClassificationNode[]
  retentionPolicies RetentionPolicy[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model RecordCategory {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  name                  String
  description           String?
  defaultRetentionYears Int?
  defaultVisibility     String       @default("PRIVATE") // PRIVATE, DEPARTMENT, ORG
  recordTypes           RecordType[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

model RecordType {
  id                String               @id @default(uuid())
  categoryId        String
  category          RecordCategory       @relation(fields: [categoryId], references: [id])
  name              String
  code              String
  description       String?
  versioningEnabled Boolean              @default(true)
  approvalRequired  Boolean              @default(false)
  retentionYears    Int?
  isActive          Boolean              @default(true)
  
  retentionPolicyId String?
  retentionPolicy   RetentionPolicy?     @relation(fields: [retentionPolicyId], references: [id])

  // Link to ClassificationNode (Level 3)
  classificationNodeId String? @unique
  classificationNode   ClassificationNode? @relation(fields: [classificationNodeId], references: [id])
  
  metadataFields    RecordTypeMetadata[]
  records           Record[]
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

// ---------------------------------------------------------
// DYNAMIC METADATA ENGINE
// ---------------------------------------------------------

model MetadataField {
  id              String               @id @default(uuid())
  name            String               @unique // e.g. "invoice_number"
  label           String               // e.g. "Invoice Number"
  dataType        String               // text, number, date, enum, etc.
  required        Boolean              @default(false)
  searchable      Boolean              @default(false)
  validationRules String?              // JSON string
  enumValues      String?              // JSON string
  
  recordTypes     RecordTypeMetadata[]
  recordValues    RecordMetadata[]
  templateFields  TemplateField[]     // New: used in dynamic templates
}

model RecordTypeMetadata {
  id              String        @id @default(uuid())
  recordTypeId    String
  recordType      RecordType    @relation(fields: [recordTypeId], references: [id])
  metadataFieldId String
  metadataField   MetadataField @relation(fields: [metadataFieldId], references: [id])
  displayOrder    Int           @default(0)
  editable        Boolean       @default(true)
}

model RecordMetadata {
  id              String        @id @default(uuid())
  recordId        String
  record          Record        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  metadataFieldId String
  metadataField   MetadataField @relation(fields: [metadataFieldId], references: [id])
  value           String        // Stores value or JSON string
}

// ---------------------------------------------------------
// DYNAMIC 3-LEVEL CLASSIFICATION SYSTEM
// ---------------------------------------------------------

model ClassificationNode {
  id             String                @id @default(uuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id])
  
  // Department Scope (Optional - if null, global for organization)
  departmentId   String?
  department     Department?           @relation(fields: [departmentId], references: [id])
  
  name           String
  level          Int                   // 1, 2, or 3
  parentId       String?
  parent         ClassificationNode?   @relation("ClassificationHierarchy", fields: [parentId], references: [id])
  children       ClassificationNode[]  @relation("ClassificationHierarchy")
  code           String?
  securityLevel  Int         @default(1) // 1=Public, 5=Top Secret
  lastSequenceNumber Int     @default(0) // Tracks the last used sequence for this node (if it's a leaf)
  isLeaf         Boolean     @default(false) // true only for level 3
  isActive       Boolean               @default(true)
  createdById    String
  createdBy      User                  @relation(fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  
  // Relations
  templates      MetadataTemplate[]
  records        Record[]
  
  retentionPolicyId String?
  retentionPolicy   RetentionPolicy?      @relation(fields: [retentionPolicyId], references: [id])
  
  // Link to RecordType (One-to-One for L3)
  recordType        RecordType?

  @@index([organizationId])
  @@index([parentId])
  @@index([level])
}

model MetadataTemplate {
  id                  String         @id @default(uuid())
  classificationNodeId String        // Must be Level 3 (isLeaf = true)
  classificationNode  ClassificationNode @relation(fields: [classificationNodeId], references: [id])
  name                String        // e.g. "Vendor Invoice Template"
  version             Int            @default(1)
  isActive            Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  // Relations
  templateFields      TemplateField[]
  // Note: Records are queried via classificationNodeId + templateVersion, not direct relation
  
  @@unique([classificationNodeId, version])
  @@index([classificationNodeId])
}

model TemplateField {
  id              String           @id @default(uuid())
  templateId      String
  template        MetadataTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  metadataFieldId String
  metadataField   MetadataField   @relation(fields: [metadataFieldId], references: [id])
  required        Boolean          @default(false)
  displayOrder    Int              @default(0)
  editable        Boolean          @default(true)
  
  @@unique([templateId, metadataFieldId])
  @@index([templateId])
}

// ---------------------------------------------------------
// CORE RECORD & VERSIONING
// ---------------------------------------------------------

model Record {
  id            String   @id @default(uuid())
  recordTypeId  String?  // Legacy field - kept for backward compatibility
  recordType    RecordType? @relation(fields: [recordTypeId], references: [id])
  
  // New dynamic classification fields
  classificationNodeId String?  // FK to Level 3 ClassificationNode
  classificationNode   ClassificationNode? @relation(fields: [classificationNodeId], references: [id])
  templateVersion      Int?     // Version of template used at creation
  // Note: Template is queried via classificationNodeId + templateVersion, not direct FK
  
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])

  projectId     String?
  project       Group?    @relation("ProjectRecords", fields: [projectId], references: [id])
  
  title         String
  ownerUserId   String?  // Renamed from userId to match spec, but keeping mapping if convenient? No, let's use ownerUserId to match spec.
  user          User?    @relation(fields: [ownerUserId], references: [id])
  
  referenceNumber String?  // Non-unique at column level to allow versions to share it
  status        String   @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  metadata      RecordMetadata[]
  versions      RecordVersion[]
  auditLogs     AuditLog[]
  access        RecordAccess[]

  // Parent/Child Relationship
  parentId      String?
  parent        Record?  @relation("RecordHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Record[] @relation("RecordHierarchy")

  // Legacy/Convenience relations for existing code (Optional, but might break if removed abruptly. 
  // For this Refactor, I am FOLLOWING THE SPEC which removes them. 
  // I will map shared lists via RecordAccess or keep them for now?)
  // The spec says RecordAccess for permissions. I will comment out legacy shared lists to enforce new usage or keep them as "Shortcuts"?
  // The user prompt implies a full replacement. I will implement RecordAccess.
  
  // Keeping these for now to minimize compile errors in unconnected parts, 
  // but they should be migrated to RecordAccess logic eventually.
  sharedWithGroups Group[] @relation("GroupSharedRecords")
  sharedWithUsers  User[]  @relation("UserSharedRecords")

  // ---------------------------------------------------------
  // GOVERNANCE & COMPLIANCE
  // ---------------------------------------------------------
  
  retentionPolicyId String?
  retentionPolicy   RetentionPolicy? @relation(fields: [retentionPolicyId], references: [id])
  dispositionDate   DateTime?        // Calculated: createdAt + policy.duration
  
  isLegalHold       Boolean          @default(false) // Optimized flag
  legalHolds        RecordLegalHold[]

  // Versioning
  versionGroupId    String?          // UUID shared by all versions of a record
  versionNumber     Int              @default(1)
  isLatest          Boolean          @default(true)

  @@index([versionGroupId])
  @@unique([referenceNumber, versionNumber]) // Ensure uniqueness per version
}

enum RetentionTrigger {
  CREATION_DATE
  LAST_MODIFIED
  CASE_CLOSED
  CONTRACT_END
  EMPLOYMENT_TERMINATION
  FISCAL_YEAR_END
}

enum DispositionAction {
  DESTROY
  REVIEW
  ARCHIVE
  ARCHIVE_THEN_DESTROY
}

enum RetentionStatus {
  ACTIVE
  DRAFT
  DEPRECATED
}

enum DurationUnit {
  DAYS
  MONTHS
  YEARS
  PERMANENT
}

enum LegalHoldStatus {
  ACTIVE
  RELEASED
  CLOSED
}

model RetentionPolicy {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?
  
  durationValue   Int?
  durationUnit    DurationUnit @default(YEARS)

  trigger         RetentionTrigger @default(CREATION_DATE)
  dispositionAction DispositionAction @default(DESTROY)

  preventDeletion Boolean  @default(true)
  status          RetentionStatus @default(ACTIVE)

  // Scope (optional)
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  
  recordTypes     RecordType[]
  classificationNodes ClassificationNode[]
  records         Record[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LegalHold {
  id              String   @id @default(uuid())
  name            String   // Case Name
  caseReference   String?  // e.g. CASE-2026-001
  description     String?  // Scope Summary
  
  ownerId         String?  // Made optional for migration safety, but logic should enforce it
  owner           User?    @relation("LegalHoldOwner", fields: [ownerId], references: [id])
  
  startDate       DateTime @default(now())
  endDate         DateTime? // Estimated end date
  
  status          LegalHoldStatus @default(ACTIVE)
  
  notificationRecipients String? // JSON array or comma-separated
  notes           String?
  
  records         RecordLegalHold[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RecordLegalHold {
  id          String    @id @default(uuid())
  recordId    String
  record      Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  legalHoldId String
  legalHold   LegalHold @relation(fields: [legalHoldId], references: [id])
  addedByUserId String? // Audit who added it
  
  createdAt   DateTime  @default(now())
  
  @@unique([recordId, legalHoldId])
}

model RecordVersion {
  id            String   @id @default(uuid())
  recordId      String
  record        Record   @relation(fields: [recordId], references: [id], onDelete: Cascade)
  versionNumber Int
  filePath      String
  fileType      String
  checksum      String?
  uploadedById  String?
  uploadedBy    User?    @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime @default(now()) // uploaded_at
  changeNote    String?
}

enum AccessLevel {
  VIEW   // See metadata/existence
  READ   // See content/download
  EDIT   // Modify metadata/content
  FULL   // Admin/Delete/Perms
}

enum AccessType {
  ALLOW
  DENY
}

model RecordAccess {
  id            String    @id @default(uuid())
  recordId      String
  record        Record    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  principalType String    // "USER" or "GROUP"
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  groupId       String?
  group         Group?    @relation(fields: [groupId], references: [id])
  
  level         AccessLevel @default(VIEW)
  accessType    AccessType  @default(ALLOW)
  
  // Legacy String field for migration (optional, can remove if we do a hard reset, but safer to keep/ignore for now)
  // permission    String    // DEPRECATED
  
  expiresAt     DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  actorRole String? // Snapshot of role at time of action
  source    String   @default("WEB") // WEB, API, SYSTEM
  ipAddress String?
  userAgent String?
  recordId  String?
  record    Record?  @relation(fields: [recordId], references: [id], onDelete: SetNull)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
  
  // Spec fields
  oldValue  String? // JSON
  newValue  String? // JSON
}

model AccessRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  reason    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// INTEGRATIONS & SCALE
// ---------------------------------------------------------

model ApiKey {
  id          String   @id @default(uuid())
  keyHash     String   @unique
  prefix      String   // e.g. "sk_live_..."
  name        String   // e.g. "Zapier Integration"
  scopes      String?  // JSON array of scopes ["records:read", "records:write"]
  
  // Optional: Link to a generic "Service Account" user?
  // For now, let's keep it simple. If we need a user ID for "createdBy", we can add it.
  createdByUserId String?
  
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isActive    Boolean  @default(true)
}

model Webhook {
  id          String   @id @default(uuid())
  url         String
  events      String   // JSON array of events ["RECORD.CREATED", "RECORD.STATUS_CHANGED"]
  secret      String   // For signing payload
  
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "ALLOW_USER_UPLOADS"
  value       String   // JSON value or simple string
  description String?
  updatedAt   DateTime @updatedAt
}
