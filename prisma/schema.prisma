generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Hashed password
  name      String?
  role      String   @default("USER") // ADMIN, USER, AUDITOR
  createdAt DateTime @default(now())
  records   Record[]
  auditLogs AuditLog[]
  groups    Group[]
  
  // New: Account Expiry
  accountExpiresAt DateTime?

  // New: Shared Records (Many-to-Many)
  sharedRecords Record[] @relation("UserSharedRecords")
}

model Group {
  id        String   @id @default(uuid())
  name      String
  type      String   // DEPARTMENT, TEAM, PROJECT
  users     User[]
  records   Record[] // Original Owner-Group Relation
  
  // New: Shared Records (Many-to-Many)
  sharedRecords Record[] @relation("GroupSharedRecords")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Record {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileType    String
  category    String
  tags        String   // JSON string of tags
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, VERIFIED, PENDING, LEGAL_HOLD
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])
  visibility  String   @default("PUBLIC") // PUBLIC, PRIVATE, GROUP

  auditLogs   AuditLog[]
  history     RecordHistory[]

  // New: Shared Lists
  sharedWithGroups Group[] @relation("GroupSharedRecords")
  sharedWithUsers  User[]  @relation("UserSharedRecords")

  // Upload Form Requirement Fields
  checksum         String?  // SHA-256 for version detection
  documentType     String?  // e.g. "Invoice", "Contract"
  department       String?  // e.g. "HR", "Legal"
  effectiveDate    DateTime?
  retentionPeriod  String?  // e.g. "7 years"
  isLegalHold      Boolean  @default(false)
  requiresApproval Boolean  @default(false)
}

model RecordHistory {
  id          String   @id @default(uuid())
  recordId    String
  record      Record   @relation(fields: [recordId], references: [id])
  
  // Copied fields
  title       String
  description String?
  fileUrl     String
  fileType    String
  category    String
  tags        String   // JSON string of tags
  status      String
  groupId     String?
  visibility  String   @default("PUBLIC")
  
  // Version metadata
  version     Int
  changedBy   String?  // Optional: User ID who made the change
  changedAt   DateTime @default(now())
  changeReason String?
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  recordId  String?
  record    Record?  @relation(fields: [recordId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timestamp DateTime @default(now())
}

model AccessRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  reason    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
}
