# ============================================================
# ERM-GIPC — Environment Variables
# Copy this file to .env and fill in real values for production.
# Run: scripts/generate-secrets.sh to auto-generate strong secrets.
# ============================================================

# --- App ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme            # REQUIRED — run generate-secrets.sh
NODE_ENV=development                # development | production

# --- Database (PostgreSQL) ---
POSTGRES_USER=erm
POSTGRES_PASSWORD=erm               # REQUIRED — change for production
POSTGRES_DB=erm
DATABASE_URL=postgresql://erm:erm@localhost:5432/erm

# --- Redis (cache + session) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch (full-text search) ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=changeme           # REQUIRED — run generate-secrets.sh

# --- MinIO / S3-compatible storage ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin      # REQUIRED — change for production
MINIO_BUCKET=uploads
MINIO_REGION=us-east-1

# --- Cron Jobs ---
CRON_SECRET=changeme                # REQUIRED — run generate-secrets.sh

# --- TLS (production only, uncomment when ready) ---
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
